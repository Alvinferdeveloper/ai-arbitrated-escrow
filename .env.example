# Copy to .env.local. Never commit real values. All keys are server-only unless prefixed NEXT_PUBLIC_.

# Demo mode: role switcher, sample evidence, short timers
NEXT_PUBLIC_DEMO_MODE=true
# Sandbox buyer account shown on the Trust Link in demo mode (sandbox only)
DEMO_PAYPAL_BUYER_EMAIL=
DEMO_PAYPAL_BUYER_PASSWORD=

# AI cost limits: audits per deal and across the app per hour
AI_AUDITS_PER_DEAL=8
AI_AUDITS_PER_HOUR=60

# Public origin used for PayPal return URLs. Optional in local dev; set it on
# Vercel (for example https://your-app.vercel.app).
APP_URL=

# PayPal (sandbox only)
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (vision model behind lib/agents/model.ts, provider picked in lib/agents/provider.ts)
# Any OpenAI-compatible Chat Completions endpoint with image input works.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Set to false when the endpoint rejects response_format json_schema.
AI_STRUCTURED_OUTPUTS=true

# Vercel Cron auth
CRON_SECRET=
