# Copy to .env.local. Never commit real values. All keys are server-only unless prefixed NEXT_PUBLIC_.

# Demo mode: role switcher, sample evidence, 2-minute auto-release
NEXT_PUBLIC_DEMO_MODE=true
AI_CALLS_PER_SESSION=20

# Public origin used for PayPal return URLs. Optional in local dev; set it on
# Vercel (for example https://your-app.vercel.app).
APP_URL=

# PayPal (sandbox only)
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (vision model behind lib/agents/model.ts)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Vercel Cron auth
CRON_SECRET=
